{
  "name": "@mooseboardgames/ur",
  "private": true,
  "type": "module",
  "dependencies": {
    "boardgame.io": "^0.50.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "open-cli": "^9.0.0",
    "parcel": "^2.16.4",
    "process": "^0.11.10",
    "wait-on": "^9.5.1"
  },
  "scripts": {
    "images": "node scripts/make-piece-images.js",
    "prestart": "npm run images",
    "start": "parcel index.html",
    "serve": "node src/server.js",
    "play": "concurrently --kill-others-on-fail -n server,client,browser \"npm:serve\" \"npm:start\" \"wait-on http://localhost:1234 && open-cli http://localhost:1234/?player=0 && open-cli http://localhost:1234/?player=1\"",
    "prebuild": "npm run images",
    "build": "parcel build index.html --public-url /games/ur/"
  },
  "browserslist": "defaults and supports async-functions"
}
